[Desktop Entry]
Type=Application
Name=图片工坊
Name[en]=ImageWorkshop
Comment=批量图片格式转换、目标体积压缩与尺寸调整
Comment[en]=Batch image conversion, compression and resizing
Exec=ImageWorkshop %F
